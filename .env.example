# Copy these variable NAMES into Render > Environment.
# Replace placeholders in Render with your own values.
# Do not commit a real .env file or paste credentials into GitHub.

BOT_TOKEN=replace_with_new_telegram_bot_token
OWNER_ID=replace_with_numeric_telegram_user_id

DB_CHANNEL=replace_with_database_channel_id
LOGS_CHANNEL=replace_with_logs_channel_id

GH_TOKEN=replace_with_github_token_with_required_repo_access
GH_REPO=owner/repository
GH_DB_PATH=database.db
